      "description": "跨东西海岸长途旅行的额外消耗",
      "value": -0.10,
      "apply_when": "travel_distance > 2000km"
    },
    "artificial_turf_penalty": {
      "description": "人工草皮对客队技术发挥的影响",
      "value": -0.10,
      "apply_when": "home_turf == 'artificial' and away_turf == 'natural'"
    },
    "playoff_motivation_boost": {
      "description": "季后赛冲刺期的战意加成",
      "value": 0.06,
      "apply_when": "team_in_playoff_race and match_after_august"
    },
    "summer_transfer_boost": {
      "description": "夏窗新援带来的实力提升",
      "value": 0.05,
      "apply_when": "team_signed_high_profile_player"
    },
    "international_callup": {
      "description": "国际比赛日征召导致的减员",
      "value": -0.06,
      "apply_when": "team_has_international_callups"
    }
  },
